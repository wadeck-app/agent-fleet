# Dependencies
node_modules/
package-lock.json

# Build output
dist/
dist-types/
*.tsbuildinfo

# Prevent compiled files in src/ (should only be in dist/)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Data files (task storage)
data/tasks/*.json
data/contexts/
data/knowledge/

# Keep directory structure but ignore contents
!data/tasks/.gitkeep
!data/contexts/.gitkeep
!data/knowledge/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/

# Temporary files
tmp/
temp/
*.tmp

# Claude temporary files
tmpclaude-*-cwd

# OS
Thumbs.db

# Custom
nul
packages/data/
packages/web-backend/data/
_results/