# ===========================================================================================
# ORCHESTRATOR SERVER DOCKERFILE
# ===========================================================================================
#
# Builds standalone orchestrator-server for remote mode deployments.
# Exposes HTTP/WebSocket endpoints for backend connections.
#
# Usage:
#   docker build -f docker/Dockerfile.orchestrator-server -t orchestrator-server .
#   docker run -p 3737:3737 orchestrator-server
#
# ===========================================================================================

FROM node:18-alpine AS base

# Install pnpm
RUN npm install -g pnpm

# ===========================================================================================
# DEPENDENCIES STAGE
# ===========================================================================================

FROM base AS dependencies

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared-common/package.json ./packages/shared-common/
COPY packages/shared-orch-backend/package.json ./packages/shared-orch-backend/
COPY packages/shared-orch-worker/package.json ./packages/shared-orch-worker/
COPY packages/flow-engine/package.json ./packages/flow-engine/
COPY packages/orchestrator/package.json ./packages/orchestrator/
COPY packages/orchestrator-server/package.json ./packages/orchestrator-server/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# ===========================================================================================
# BUILD STAGE
# ===========================================================================================

FROM base AS builder

WORKDIR /app

# Copy dependencies from previous stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages ./packages

# Copy source code
COPY packages/shared-common ./packages/shared-common
COPY packages/shared-orch-backend ./packages/shared-orch-backend
COPY packages/shared-orch-worker ./packages/shared-orch-worker
COPY packages/flow-engine ./packages/flow-engine
COPY packages/orchestrator ./packages/orchestrator
COPY packages/orchestrator-server ./packages/orchestrator-server
COPY package.json pnpm-workspace.yaml ./

# Build all packages
RUN pnpm --filter shared-common build
RUN pnpm --filter shared-orch-backend build
RUN pnpm --filter shared-orch-worker build
RUN pnpm --filter flow-engine build
RUN pnpm --filter orchestrator build
RUN pnpm --filter orchestrator-server build

# ===========================================================================================
# PRODUCTION STAGE
# ===========================================================================================

FROM base AS production

WORKDIR /app

# Copy workspace configuration
COPY package.json pnpm-workspace.yaml ./

# Copy built packages
COPY --from=builder /app/packages/shared-common/dist ./packages/shared-common/dist
COPY --from=builder /app/packages/shared-common/package.json ./packages/shared-common/
COPY --from=builder /app/packages/shared-orch-backend/dist ./packages/shared-orch-backend/dist
COPY --from=builder /app/packages/shared-orch-backend/package.json ./packages/shared-orch-backend/
COPY --from=builder /app/packages/shared-orch-worker/dist ./packages/shared-orch-worker/dist
COPY --from=builder /app/packages/shared-orch-worker/package.json ./packages/shared-orch-worker/
COPY --from=builder /app/packages/flow-engine/dist ./packages/flow-engine/dist
COPY --from=builder /app/packages/flow-engine/package.json ./packages/flow-engine/
COPY --from=builder /app/packages/orchestrator/dist ./packages/orchestrator/dist
COPY --from=builder /app/packages/orchestrator/package.json ./packages/orchestrator/
COPY --from=builder /app/packages/orchestrator-server/dist ./packages/orchestrator-server/dist
COPY --from=builder /app/packages/orchestrator-server/package.json ./packages/orchestrator-server/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Expose orchestrator-server port
EXPOSE 3737

# Set environment variables
ENV NODE_ENV=production

# Start orchestrator-server
CMD ["node", "packages/orchestrator-server/dist/server.js"]
