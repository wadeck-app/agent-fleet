{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./dist",
		"declarationMap": true,
		"baseUrl": ".",
		"paths": {
			"@app/shared-orch-backend": ["../shared-orch-backend/src"],
			"@app/shared-orch-backend/*": ["../shared-orch-backend/src/*"],
			"shared-common": ["../shared-common/src"],
			"shared-common/*": ["../shared-common/src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
	"references": [
		{
			"path": "../shared-common"
		},
		{
			"path": "../shared-orch-backend"
		}
	]
}
