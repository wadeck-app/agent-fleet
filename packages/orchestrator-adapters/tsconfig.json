{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./dist",
		"declarationMap": true,
		"baseUrl": ".",
		"paths": {
			"shared-common": ["../shared-common/src"],
			"shared-common/*": ["../shared-common/src/*"],
			"shared-orch-worker": ["../shared-orch-worker/src"],
			"shared-orch-worker/*": ["../shared-orch-worker/src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
	"references": [
		{
			"path": "../shared-common"
		},
		{
			"path": "../shared-orch-worker"
		}
	]
}
