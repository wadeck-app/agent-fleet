{
	"name": "worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"dev": "nodemon --project-root=../.. --no-ui",
		"dev:no-watch": "tsx src/flow/FlowWorker.ts --no-ui",
		"dev:ui": "nodemon --args ''",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "echo 'No ESLint configured for worker'",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"shared-orch-worker": "*",
		"shared-common": "*",
		"flow-engine": "*",
		"dotenv": "^16.3.1",
		"ws": "^8.16.0",
		"react": "^19.2.0",
		"ink": "^6.5.1",
		"terminal-kit": "^3.1.2"
	},
	"devDependencies": {
		"test-utils": "*",
		"@types/ws": "^8.5.10",
		"@types/terminal-kit": "^2.5.7",
		"@types/react": "^19.2.7",
		"typescript": "^5.3.3",
		"vitest": "^4.0.14",
		"tsx": "^4.7.0",
		"nodemon": "^3.1.11"
	}
}
