{
	"name": "flow-core",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@wadeck-app/singleton-daemon-kit": "latest",
		"js-yaml": "^4.1.1"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"extension-points": "file:../extension-points",
		"flow-engine": "file:../flow-engine",
		"typescript": "^7.0.0",
		"vitest": "^4.0.14"
	}
}
