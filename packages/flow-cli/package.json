{
	"name": "flow-cli",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"flow": "./bin/flow.js",
		"task": "./bin/task.js"
	},
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"postbuild": "node -e \"require('fs').copyFileSync('src/worker/mcp-server.cjs','dist/worker/mcp-server.cjs')\"",
		"pretest": "tsc --build tsconfig.json",
		"build-launcher": "node scripts/build-launcher.mjs",
		"dev": "tsx src/cli.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"clean": "rimraf dist",
		"bundle": "tsx scripts/bundle.ts",
		"bundle-task": "tsx scripts/bundle-task.ts",
		"bundle-updater": "tsx scripts/bundle-updater.ts",
		"bundle:all": "npm run bundle && npm run bundle-task && npm run bundle-updater"
	},
	"dependencies": {
		"extension-points": "file:../extension-points",
		"plugin-none": "file:../plugin-none",
		"plugin-worktree": "file:../plugin-worktree",
		"plugin-cli-approval": "file:../plugin-cli-approval",
		"@wadeck/singleton-daemon-kit": "^1.20260816144341.57",
		"commander": "^12.1.0",
		"flow-engine": "file:../flow-engine",
		"js-yaml": "^4.1.1",
		"shared-common": "file:../shared-common",
		"ws": "^8.0.0"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/ws": "^8.0.0",
		"esbuild": "^0.27.2",
		"tsx": "^4.7.0",
		"typescript": "^5.3.3",
		"vitest": "^4.0.14"
	}
}
