{
	"name": "flow-cli",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"flow": "./bin/flow.js",
		"task": "./bin/task.js"
	},
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"postbuild": "node -e \"require('fs').copyFileSync('src/worker/mcp-server.cjs','dist/worker/mcp-server.cjs')\"",
		"pretest": "tsc --build tsconfig.json",
		"build-launcher": "node ci/scripts/build-launcher.mjs",
		"dev": "tsx src/cli.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"preversion": "node -e \"if (!process.env.CI) { process.exit(1); }\"",
		"clean": "rimraf dist dist-bundle",
		"bundle": "tsx ci/scripts/bundle.ts"
	},
	"dependencies": {
		"@wadeck-app/shared-cli": "^2026.8.31-022-55ef14e0",
		"@wadeck-app/shared-updater": "^2026.8.31-006-6811218a",
		"@wadeck-app/singleton-daemon-kit": "2026.8.30-082-8c02b26d",
		"commander": "^12.1.0",
		"extension-points": "file:../extension-points",
		"flow-engine": "file:../flow-engine",
		"js-yaml": "^4.1.1",
		"plugin-cli-approval": "file:../plugin-cli-approval",
		"plugin-none": "file:../plugin-none",
		"plugin-worktree": "file:../plugin-worktree",
		"shared-common": "file:../shared-common",
		"ws": "^8.0.0"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/ws": "^8.0.0",
		"esbuild": "^0.27.2",
		"tsx": "^4.7.0",
		"typescript": "^7.0.0",
		"vitest": "^4.0.14"
	}
}
