{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"declarationDir": "dist-types",
		"rootDir": "src",
		"types": ["vitest/globals", "node"],
		"baseUrl": ".",
		"paths": {
			"flow-engine": ["../flow-engine/src"],
			"flow-engine/*": ["../flow-engine/src/*"],
			"shared-common": ["../shared-common/src"],
			"shared-common/*": ["../shared-common/src/*"]
		}
	},
	"include": ["src"],
	"references": [{ "path": "../flow-engine" }, { "path": "../shared-common" }]
}
