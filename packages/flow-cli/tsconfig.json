{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"declarationDir": "dist-types",
		"rootDir": "src",
		"types": ["vitest/globals", "node"],
		"baseUrl": ".",
		"paths": {
			"shared-cli": ["../shared-cli/src/index"],
			"shared-cli/*": ["../shared-cli/src/*"],
			"extension-points": ["../extension-points/src/index"],
			"flow-engine": ["../flow-engine/src"],
			"flow-engine/*": ["../flow-engine/src/*"],
			"shared-common": ["../shared-common/src"],
			"shared-common/*": ["../shared-common/src/*"]
		}
	},
	"include": ["src"],
	"references": [
		{ "path": "../shared-cli" },
		{ "path": "../extension-points" },
		{ "path": "../flow-engine" },
		{ "path": "../shared-common" }
	]
}
