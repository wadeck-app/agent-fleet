{
	"name": "shared-orch-worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./*.js": "./dist/*.js",
		"./*": "./dist/*"
	},
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"dev": "tsc --build tsconfig.json --watch",
