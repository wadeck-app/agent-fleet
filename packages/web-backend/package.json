{
	"name": "web-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/server.js",
	"types": "./dist/server.d.ts",
	"scripts": {
		"build": "node build.mjs",
		"build:tsc": "tsc --build tsconfig.json",
		"build:analyze": "node build.mjs && npm run analyze",
		"analyze": "esbuild --metafile=dist/meta.json --analyze",
		"dev": "nodemon --watch src --watch ../shared-frontend-backend/src --watch ../shared-orch-backend/src --watch ../shared-common/src --exec tsx src/server.ts",
		"dev:debug": "tsx src/server.ts",
		"dev:only-for-e2e": "tsx src/server.ts",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rimraf dist",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix"
	},
	"dependencies": {
		"@fastify/cors": "^11.1.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/sensible": "^6.0.4",
		"@fastify/static": "^8.0.3",
		"dotenv": "^16.4.5",
		"fastify": "^5.6.2",
		"fastify-plugin": "^5.1.0",
		"shared-common": "*",
		"shared-frontend-backend": "*",
		"shared-orch-backend": "*",
		"zod": "^3.24.1",
		"zod-to-json-schema": "^3.25.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/node": "^22.10.2",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"@vitest/coverage-v8": "^2.1.8",
		"@vitest/ui": "^2.1.8",
		"esbuild": "^0.27.2",
		"eslint": "^9.17.0",
		"eslint-plugin-import": "^2.32.0",
		"nodemon": "^3.1.11",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.48.1",
		"vitest": "^2.1.8"
	}
}
