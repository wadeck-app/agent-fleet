{
	"name": "web-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --inspect=0 src/server.ts",
		"dev:nodemon": "nodemon",
		"dev:library": "cross-env ORCHESTRATOR_MODE=library nodemon",
		"dev:remote": "cross-env ORCHESTRATOR_MODE=remote ORCHESTRATOR_URL=http://localhost:3737 nodemon",
		"dev:debug": "tsx src/server.ts",
		"dev:only-for-e2e": "tsx src/server.ts",
		"check-tsx": "wmic process where \"CommandLine like '%tsx%watch%'\" get ProcessId,CommandLine",
		"check-ports": "netstat -ano | findstr \":3030 :3731\"",
		"build": "node build.mjs",
		"build:tsc": "tsc --build tsconfig.json",
		"build:analyze": "node build.mjs && npm run analyze",
		"analyze": "esbuild --metafile=dist/meta.json --analyze",
		"start": "node dist/server.js",
		"start:library": "cross-env ORCHESTRATOR_MODE=library node dist/server.js",
		"start:remote": "cross-env ORCHESTRATOR_MODE=remote node dist/server.js",
		"migrate": "tsx src/migrations/MigrateToBackendStorage.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rimraf dist",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix"
	},
	"dependencies": {
		"@fastify/cookie": "^10.0.1",
		"@fastify/cors": "^11.1.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/sensible": "^6.0.4",
		"@fastify/static": "^8.0.3",
		"@fastify/websocket": "^11.0.0",
		"@types/cookie": "^0.6.0",
		"@types/jsonwebtoken": "^9.0.7",
		"cookie": "^1.0.2",
		"dotenv": "^16.4.5",
		"fastify": "^5.6.2",
		"fastify-plugin": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"shared-common": "*",
		"shared-frontend-backend": "*",
		"shared-orch-worker": "*",
		"zod": "^4.1.13",
		"zod-to-json-schema": "^3.25.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/node": "^22.10.2",
		"@types/supertest": "^6.0.2",
		"@vitest/coverage-v8": "^2.1.8",
		"@vitest/ui": "^2.1.8",
		"cross-env": "^7.0.3",
		"esbuild": "^0.27.2",
		"nodemon": "^3.1.11",
		"orchestrator": "*",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
