# ===========================================================================================
# EXAMPLE ENVIRONMENT - REMOTE MODE
# ===========================================================================================
# This example shows configuration for remote mode (orchestrator as separate service).
# Copy to .env and customize for your environment.
#
# Remote Mode Benefits:
# - Horizontal scalability (multiple backends → single orchestrator)
# - Independent deployment/scaling
# - Fault isolation (backend crash ≠ orchestrator crash)
# - Perfect for production and high availability
# ===========================================================================================

# Workspace Configuration
WORKSPACE_ID=0

# Node Environment
NODE_ENV=production

# Database Mode
USE_PRODUCTION_DB=false

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# ===========================================================================================
# Orchestrator Configuration - REMOTE MODE
# ===========================================================================================

# Mode: Remote (connect to external orchestrator-server)
ORCHESTRATOR_MODE=remote

# Remote Mode URL (orchestrator-server HTTP/WebSocket endpoint)
# Development: http://localhost:3737
# Docker: http://orchestrator-server:3737
# Production: https://orchestrator.your-domain.com
ORCHESTRATOR_URL=http://localhost:3737

# Transport Protocol (auto-fallback recommended)
# - auto: Try WebSocket → REST+SSE → REST+LongPolling (recommended)
# - websocket: Bidirectional WebSocket (best performance, may be blocked by firewall)
# - rest-sse: REST + Server-Sent Events (good fallback, HTTP-based)
# - rest-longpolling: REST + Long-polling (maximum compatibility, higher latency)
ORCHESTRATOR_TRANSPORT=auto

# ===========================================================================================
# Library Mode Settings - NOT USED IN REMOTE MODE
# ===========================================================================================
# These settings are ignored when ORCHESTRATOR_MODE=remote
# Uncomment and configure only if switching to library mode

# ORCHESTRATOR_WS_PORT=3738
# ORCHESTRATOR_REST_PORT=3737
