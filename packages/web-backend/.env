# Server Configuration
# PROJECT_ID and WORKSPACE_ID are defined in root .env / root .env.local
NODE_ENV=development

USE_PRODUCTION_DB=false

# ===========================================================================================
# AUTHENTICATION CONFIGURATION
# ===========================================================================================
#
# DISABLE_AUTH_DEV: Bypass authentication for development
#
# When set to 'true':
# - All REST API auth checks return authenticated
# - All WebSocket connections are auto-authenticated
# - Uses mock user: dev-user-no-auth
#
# SECURITY PROTECTIONS (enforced in code):
# 1. Server will CRASH at startup if DISABLE_AUTH_DEV=true and NODE_ENV=production
# 2. Each auth endpoint double-checks NODE_ENV before bypassing
# 3. Large warning logged on every server startup when enabled
#
# ⚠️  DO NOT SET TO TRUE IN PRODUCTION - The server will refuse to start!
# ===========================================================================================
DISABLE_AUTH_DEV=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
ORCHESTRATOR_URL=http://localhost:3737
