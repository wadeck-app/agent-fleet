# Workspace Configuration (for parallel development)
# Set WORKSPACE_ID (0-4) to run multiple instances without port conflicts
# Ports are calculated automatically: Backend=3000+(ID*100), Frontend=5000+(ID*100), etc.
# Example: WORKSPACE_ID=0 → Backend:3000, Frontend:5000 | WORKSPACE_ID=1 → Backend:3100, Frontend:5100
WORKSPACE_ID=0

NODE_ENV=development

# Database Mode (SAFE BY DEFAULT)
# By default, the backend uses IN-MEMORY repositories (safe for development/testing)
# Set USE_PRODUCTION_DB=true to explicitly use Google Sheets (production database)
# This prevents accidental writes to production during development and testing
# USE_PRODUCTION_DB=false  # Default: false (uses in-memory)

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# CORS
# In development mode, all origins are accepted automatically
# In production, set this to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# ===========================================================================================
# Orchestrator Configuration
# ===========================================================================================
# The backend can connect to orchestrator in two modes:
# 1. LIBRARY MODE (default): Orchestrator runs in the same process (embedded)
# 2. REMOTE MODE: Orchestrator runs as a separate server process

# Orchestrator Mode: 'library' or 'remote'
# - library: Embedded orchestrator (same process, uses dynamic import)
# - remote: Connect to external orchestrator-server via HTTP/WebSocket
ORCHESTRATOR_MODE=library

# Remote Mode Configuration (only used when ORCHESTRATOR_MODE=remote)
# URL of the orchestrator-server (HTTP/WebSocket endpoint)
ORCHESTRATOR_URL=http://localhost:3737

# Transport protocol for remote mode: 'auto', 'websocket', 'rest-sse', 'rest-longpolling'
# - auto: Try WebSocket → REST+SSE → REST+LongPolling (recommended)
# - websocket: Bidirectional WebSocket (best performance)
# - rest-sse: REST requests + Server-Sent Events (good fallback)
# - rest-longpolling: REST + Long-polling (maximum compatibility)
ORCHESTRATOR_TRANSPORT=auto

# Library Mode Configuration (only used when ORCHESTRATOR_MODE=library)
# Ports for embedded orchestrator
ORCHESTRATOR_WS_PORT=3738
ORCHESTRATOR_REST_PORT=3737
