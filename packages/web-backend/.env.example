# Workspace Configuration (for parallel development)
# Set WORKSPACE_ID (0-4) to run multiple instances without port conflicts
# Ports are calculated automatically: Backend=3000+(ID*100), Frontend=5000+(ID*100), etc.
# Example: WORKSPACE_ID=0 → Backend:3000, Frontend:5000 | WORKSPACE_ID=1 → Backend:3100, Frontend:5100
WORKSPACE_ID=0

NODE_ENV=development

# Database Mode (SAFE BY DEFAULT)
# By default, the backend uses IN-MEMORY repositories (safe for development/testing)
# Set USE_PRODUCTION_DB=true to explicitly use Google Sheets (production database)
# This prevents accidental writes to production during development and testing
# USE_PRODUCTION_DB=false  # Default: false (uses in-memory)

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# CORS
# In development mode, all origins are accepted automatically
# In production, set this to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
