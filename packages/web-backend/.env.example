NODE_ENV=development

# Database Mode (SAFE BY DEFAULT)
# By default, the backend uses IN-MEMORY repositories (safe for development/testing)
# Set USE_PRODUCTION_DB=true to explicitly use Google Sheets (production database)
# This prevents accidental writes to production during development and testing
# USE_PRODUCTION_DB=false  # Default: false (uses in-memory)

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# CORS
# In development mode, all origins are accepted automatically
# In production, set this to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# ===========================================================================================
# Orchestrator Configuration
# ===========================================================================================
# The orchestrator runs embedded in the backend process (library mode).
# This provides zero-latency communication and simplified deployment.

# Ports for embedded orchestrator
# By default, ports are calculated based on PROJECT_ID and WORKSPACE_ID:
# - REST_PORT: basePort (3737) + (PROJECT_ID * 10) + (WORKSPACE_ID * 100)
# - WS_PORT: REST_PORT + 1
#
# Explicit overrides (optional):
# - ORCHESTRATOR_REST_PORT: Override calculated REST port (e.g., for remote orchestrator)
# - ORCHESTRATOR_WS_PORT: Override calculated WS port (e.g., for remote orchestrator)
#
# Examples:
# - PROJECT_ID=0, WORKSPACE_ID=0 → REST:3737, WS:3738
# - PROJECT_ID=3, WORKSPACE_ID=0 → REST:3767, WS:3768
# - PROJECT_ID=0, WORKSPACE_ID=1 → REST:3837, WS:3838
# ORCHESTRATOR_REST_PORT=3737  # Optional: explicit override
# ORCHESTRATOR_WS_PORT=3738    # Optional: explicit override
