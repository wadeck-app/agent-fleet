# ===========================================================================================
# EXAMPLE ENVIRONMENT - LIBRARY MODE
# ===========================================================================================
# This example shows configuration for library mode (embedded orchestrator).
# Copy to .env and customize for your environment.
#
# Library Mode Benefits:
# - Zero network latency (<1ms)
# - Simpler deployment (single process)
# - Lower resource usage
# - Perfect for development and small deployments
# ===========================================================================================

# Workspace Configuration
WORKSPACE_ID=0

# Node Environment
NODE_ENV=development

# Database Mode
USE_PRODUCTION_DB=false

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# ===========================================================================================
# Orchestrator Configuration - LIBRARY MODE
# ===========================================================================================

# Mode: Library (embedded orchestrator in same process)
ORCHESTRATOR_MODE=library

# Library Mode Ports (orchestrator runs in-process)
ORCHESTRATOR_WS_PORT=3738
ORCHESTRATOR_REST_PORT=3737

# ===========================================================================================
# Remote Mode Settings - NOT USED IN LIBRARY MODE
# ===========================================================================================
# These settings are ignored when ORCHESTRATOR_MODE=library
# Uncomment and configure only if switching to remote mode

# ORCHESTRATOR_URL=http://localhost:3737
# ORCHESTRATOR_TRANSPORT=auto
