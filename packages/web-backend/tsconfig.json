{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"baseUrl": ".",
		"paths": {
			"@app/shared": ["../shared-frontend-backend/src"],
			"@app/shared/*": ["../shared-frontend-backend/src/*"],
			"orchestrator-adapters": ["../orchestrator-adapters/src"],
			"orchestrator-adapters/*": ["../orchestrator-adapters/src/*"],
			"shared-common": ["../shared-common/src"],
			"shared-common/*": ["../shared-common/src/*"],
			"shared-orch-worker": ["../shared-orch-worker/src"],
			"shared-orch-worker/*": ["../shared-orch-worker/src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
	"references": [
		{ "path": "../orchestrator-adapters" },
		{ "path": "../shared-frontend-backend" },
		{ "path": "../shared-orch-worker" },
		{ "path": "../shared-common" }
	]
}
