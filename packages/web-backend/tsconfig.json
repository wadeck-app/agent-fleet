{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"outDir": "./dist",
		"paths": {
			//FIXME to be cleaned up with all using @ prefix
			"@app/shared": ["../shared-frontend-backend/src"],
			"@app/shared/*": ["../shared-frontend-backend/src/*"],
			//			"shared-frontend-backend": ["../shared-frontend-backend/src"],
			//			"shared-frontend-backend/*": ["../shared-frontend-backend/src/*"],
			"flow-engine": ["../flow-engine/src"],
			"flow-engine/*": ["../flow-engine/src/*"],
			"orchestrator": ["../orchestrator/src"],
			"orchestrator/*": ["../orchestrator/src/*"],
			"shared-common": ["../shared-common/src"],
			"shared-common/*": ["../shared-common/src/*"],
			"shared-orch-worker": ["../shared-orch-worker/src"],
			"shared-orch-worker/*": ["../shared-orch-worker/src/*"],
			"extension-points/workspace/v1": ["../extension-points/src/workspace/v1"],
			"extension-points/approval/v1": ["../extension-points/src/approval/v1"]
			//			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
	"references": [
		{ "path": "../orchestrator" },
		{ "path": "../shared-frontend-backend" },
		{ "path": "../shared-orch-worker" },
		{ "path": "../flow-engine" },
		{ "path": "../shared-common" },
		{ "path": "../extension-points" }
	]
}
