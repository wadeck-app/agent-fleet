{
	"id": "flow",
	"dslLib": {
		"shared": {
			"react": "^19",
			"react-router-dom": "^7",
			"@wadeck-app/dsl-ui": ">=2026.10.24-153",
			"@wadeck-app/dsl-renderer": ">=2026.10.24-153"
		}
	},
	"expose": {
		"slots": {
			"execution-links": {
				"accepts": ["flow-chart:FlowChartLink"]
			},
			"execution-actions": {
				"accepts": ["flow-chart:FlowChartLink"]
			},
			"executions-actions": {
				"accepts": ["flow-chart:FlowChartLink"]
			},
			"execution-row-actions": {
				"accepts": ["flow-chart:FlowChartLink"]
			},
			"execution-row-links": {
				"accepts": ["flow-chart:FlowChartLink"]
			}
		}
	},
	"extensionPoints": [
		{
			"kind": "widget",
			"slot": "dashboard",
			"label": "Flow Executions",
			"width": 3,
			"height": 4,
			"view": { "type": "path", "value": "./src/dsl-views/executions-widget.yaml" }
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Flow Executions",
			"path": "/executions",
			"view": { "type": "path", "value": "./src/dsl-views/executions-page.yaml" }
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Execution",
			"path": "/executions/:id",
			"view": { "type": "path", "value": "./src/dsl-views/execution-detail-page.yaml" }
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Logs",
			"path": "/executions/:id/logs",
			"view": { "type": "path", "value": "./src/dsl-views/execution-logs-page.yaml" }
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Flow Workers",
			"path": "/workers",
			"view": { "type": "path", "value": "./src/dsl-views/workers-page.yaml" }
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Flow Logs",
			"path": "/logs",
			"view": { "type": "path", "value": "./src/dsl-views/logs-page.yaml" }
		},
		{
			"kind": "page",
			"slot": "nav",
			"label": "Flow Plugins",
			"path": "/plugins",
			"view": { "type": "path", "value": "./src/dsl-views/plugins-page.yaml" }
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Plugin",
			"path": "/plugins/:id",
			"view": { "type": "path", "value": "./src/dsl-views/plugin-detail-page.yaml" }
		}
	]
}
