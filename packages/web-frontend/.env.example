# Workspace Configuration (for parallel development)
# Set WORKSPACE_ID (0-4) to run multiple instances without port conflicts
# Must match the backend WORKSPACE_ID for correct proxy routing
VITE_WORKSPACE_ID=0

# Project Configuration (for parallel development across multiple projects)
# Set PROJECT_ID (0-9) to run multiple projects without port conflicts
# Port is calculated: 5000 + (PROJECT_ID * 10) + (WORKSPACE_ID * 100)
VITE_PROJECT_ID=0

# API Configuration
# API_HOST: Hostname or IP address of the backend server
# - For localhost dev: "localhost"
# - For cross-device dev (mobile/tablet): Your PC's IP (e.g., "192.168.1.242")
# Port is calculated automatically: 3000 + (PROJECT_ID * 10) + (WORKSPACE_ID * 100)
#
# Examples with PROJECT_ID=3, WORKSPACE_ID=0:
#   VITE_API_HOST=localhost        → http://localhost:3030/api
#   VITE_API_HOST=192.168.1.242    → http://192.168.1.242:3030/api
#
# Advanced: Override with full URL (ignores VITE_API_HOST, PROJECT_ID, and WORKSPACE_ID)
# VITE_API_BASE_URL=http://custom-server:9999/api

VITE_API_HOST=localhost
