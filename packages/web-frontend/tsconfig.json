{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "@storybook/react", "node"],
		"paths": {
			"@/*": ["./src/*"],
			"@framework/*": ["./src/framework/*"],
			"@app/*": ["./src/app/*"],
			"@transport/*": ["./src/transport/*"],
			"@shared": ["../shared-frontend-backend/src/index.ts"],
			"@shared/*": ["../shared-frontend-backend/src/*"]
		}
	},
	"include": ["src/**/*"],
	"references": [
		{
			"path": "../shared-frontend-backend"
		}
	]
}
