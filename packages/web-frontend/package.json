{
	"name": "web-frontend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --strictPort",
		"dev:only-for-e2e": "cross-env-shell vite --mode e2e --port $VITE_E2E_PORT --strictPort",
		"build": "tsc --project tsconfig.build.json && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"storybook": "storybook dev -p 6006",
		"storybook:only-for-e2e": "node ../../scripts/storybook-e2e.js",
		"clean": "rimraf dist",
		"clean:cache": "rimraf node_modules/.vite"
	},
	"dependencies": {
