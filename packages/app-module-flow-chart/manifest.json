{
	"id": "flow-chart",
	"requires": {
		"flow": "*"
	},
	"dslLib": {
		"shared": {
			"react": "^19",
			"react-router-dom": "^7",
			"@wadeck-app/dsl-ui": ">=2026.10.24-153",
			"@wadeck-app/dsl-renderer": ">=2026.10.24-153"
		}
	},
	"extensionPoints": [
		{
			"kind": "widget",
			"slot": "flow:execution-links",
			"label": "Flow definition",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/execution-link.yaml"
			}
		},
		{
			"kind": "widget",
			"slot": "flow:execution-row-links",
			"label": "Flow definition",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/execution-row-link.yaml"
			}
		},
		{
			"kind": "widget",
			"slot": "flow:execution-actions",
			"label": "Flow chart",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/execution-action.yaml"
			}
		},
		{
			"kind": "widget",
			"slot": "flow:execution-row-actions",
			"label": "Flow chart",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/execution-row-action.yaml"
			}
		},
		{
			"kind": "widget",
			"slot": "flow:executions-actions",
			"label": "Flow charts",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/executions-action.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "flow:nav",
			"label": "Flow Charts",
			"order": 10,
			"path": "/flows",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/flows-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Flow",
			"path": "/flows/:flowId",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/flow-chart-page.yaml"
			}
		},
		{
			"kind": "page",
			"slot": "route",
			"label": "Execution",
			"path": "/flows/runs/:id",
			"view": {
				"type": "path",
				"value": "./src/dsl-views/execution-chart-page.yaml"
			}
		}
	]
}
