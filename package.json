{
	"name": "agent-fleet",
	"version": "0.1.0",
	"description": "Multi-agent orchestration system for autonomous development",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"build:orchestrator": "npm run build --workspace=orchestrator",
		"build:worker": "npm run build --workspace=worker",
		"build:flow-engine": "npm run build --workspace=flow-engine",
		"build:test-utils": "npm run build --workspace=test-utils",
		"build:cli": "npm run build --workspace=cli",
		"build:backend": "npm run build --workspace=web-backend",
		"build:frontend": "npm run build --workspace=web-frontend",
		"build:shared": "npm run build --workspace=shared-common && npm run build --workspace=shared-orch-worker && npm run build --workspace=shared-frontend-backend && npm run build --workspace=shared-orch-backend",
		"--------------------dev": "",
		"dev": "concurrently -n backend,frontend,worker,ts -c blue,green,yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:worker\" \"npm run typecheck:watch:no-pretty\"",
		"dev:orchestrator": "npm run dev --workspace=orchestrator",
		"dev:worker": "npm run dev --workspace=worker",
		"dev:backend": "npm run dev --workspace=web-backend",
		"dev:backend:full": "npm run dev --workspace=shared-frontend-backend --workspace=shared-orch-backend --workspace=web-backend",
		"dev:frontend": "npm run dev --workspace=web-frontend",
		"dev:cli": "npm run dev --workspace=cli",
		"typecheck:watch": "tsc -b -w",
		"typecheck:watch:no-pretty": "tsc -b -w --pretty false",
		"--------------------test": "",
		"test": "node scripts/test-all.js",
		"test:all": "npm run test --workspaces --if-present",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"test:e2e": "npm run test --workspace=e2e-web",
		"test:e2e:ui": "npm run test:app:ui --workspace=e2e-web",
		"test:agent": "node scripts/test-agent.js",
		"test:agent:unit": "node scripts/test-agent.js --type=unit",
		"test:agent:e2e": "node scripts/test-agent.js --type=e2e-functional",
		"test:agent:frontend": "node scripts/test-agent.js --suite=*Frontend*",
		"test:agent:backend": "node scripts/test-agent.js --suite=*Backend*",
		"test:agent:shared": "node scripts/test-agent.js --suite=*Shared*",
		"------------------------check": "",
		"check": "node scripts/check-all.js",
		"check:ts": "node scripts/check-ts.js",
		"check:eslint": "node scripts/check-eslint.js",
		"check:format": "node scripts/check-format.js",
		"format": "prettier --write .",
		"------------------------lint": "",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"--------------------misc": "",
		"clean": "npm run clean --workspaces --if-present",
		"clean:all": "npm run clean && rimraf node_modules package-lock.json",
		"cleanup:e2e": "node scripts/cleanup-e2e-zombies.cjs",
		"install:all": "npm install"
	},
	"keywords": [
		"ai",
		"agents",
		"orchestration",
		"claude"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/node": "^20.11.0",
		"@vitest/coverage-v8": "^4.0.14",
		"chalk": "^5.6.2",
		"concurrently": "^9.2.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^3.6.0",
		"eslint-plugin-better-tailwindcss": "^3.8.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"glob": "^13.0.0",
		"globals": "^16.2.0",
		"prettier": "^3.4.2",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"rimraf": "^6.1.2",
		"tsx": "^4.7.0",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.32.1",
		"vitest": "^4.0.14"
	},
	"dependencies": {
		"embla-carousel-react": "^8.6.0"
	}
}
