{
  "name": "agent-fleet",
  "version": "0.1.0",
  "description": "Multi-agent orchestration system for autonomous development",
  "main": "dist/orchestrator/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/orchestrator/index.ts",
    "start": "node dist/orchestrator/index.js",
    "add-task": "tsx src/cli/entry-point.ts",
    "worker:dev": "tsx src/workers/dev-worker.ts",
    "worker:dev:i": "tsx src/workers/dev-worker.ts --interactive",
    "worker:dev:interactive": "tsx src/workers/dev-worker.ts --interactive",
    "worker:dev:test": "tsx src/workers/dev-worker.ts --interactive --test",
    "worker:flow": "tsx src/workers/flow-worker.ts",
    "worker:flow:i": "tsx src/workers/flow-worker.ts --interactive",
    "worker:flow:interactive": "tsx src/workers/flow-worker.ts --interactive",
    "test:old": "tsx test/simple-task.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/react": "^19.2.7",
    "express": "^4.18.2",
    "ink": "^6.5.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.0",
    "simple-git": "^3.30.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.14"
  }
}
