{
  "name": "agent-fleet",
  "version": "0.1.0",
  "description": "Multi-agent orchestration system for autonomous development",
  "main": "dist/orchestrator/core/index.js",
  "type": "module",
  "bin": {
    "fleet-orchestrator": "./bin/fleet-orchestrator.js",
    "fleet-worker": "./bin/fleet-worker.js",
    "fleet-task": "./bin/fleet-task.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/orchestrator/core/index.ts",
    "orch:dev": "tsx src/orchestrator/core/index.ts",
    "orch:ui": "tsx src/orchestrator/core/index.ts",
    "start": "node dist/orchestrator/core/index.js",
    "add-task": "tsx src/cli/entry-point.ts",
    "worker:flow": "tsx src/workers/flow/FlowWorker.ts",
    "worker:flow:i": "tsx src/workers/flow/FlowWorker.ts --interactive",
    "worker:flow:ui": "tsx src/workers/flow/FlowWorker.ts",
    "worker:flow:i:ui": "tsx src/workers/flow/FlowWorker.ts --interactive",
    "test:old": "tsx test/simple-task.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "tsx test-ui.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/react": "^19.2.7",
    "express": "^4.18.2",
    "ink": "^6.5.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.0",
    "simple-git": "^3.30.0",
    "terminal-kit": "^3.1.2",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.3",
    "@types/terminal-kit": "^2.5.7",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.0.14",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.14"
  }
}
